// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  password String
  bio String?
  sentMsg Message[] @relation("sent-msg")
  receiveMsg Message[] @relation("receive-msg")
}

model Message {
  id Int @id @default(autoincrement())
  content String
  createdAt DateTime @default(now())
  authorId Int
  author User @relation("sent-msg", fields: [authorId], references: [id])
  toUserId Int
  toUser User @relation("receive-msg", fields: [toUserId], references: [id])
}